{
  "//": "One entry per query the app actually runs. Firestore builds single-field indexes on its own, so only the multi-field combinations are listed here.",
  "indexes": [
    {
      "//": "Bookings tabs: upcoming / active / completed are a status `in` filter, newest slot first.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "slot.date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Service history on a saved appliance.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "userApplianceId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "The hold-expiry sweep, every five minutes.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "holdExpiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "invoices",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "issuedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "My Warranties, soonest to expire first.",
      "collectionGroup": "warranties",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "The daily reminder three days before a warranty lapses.",
      "collectionGroup": "warranties",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "expiresAt", "order": "ASCENDING" },
        { "fieldPath": "uid", "order": "ASCENDING" }
      ]
    },
    {
      "//": "My Plans, soonest to expire first.",
      "collectionGroup": "userPlans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "What covers this booking: an unexpired plan naming this appliance.",
      "collectionGroup": "userPlans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "applianceIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "The gift cards a customer has bought, newest first.",
      "collectionGroup": "giftCards",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "purchasedBy", "order": "ASCENDING" },
        { "fieldPath": "purchasedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "The catalog of plans on offer, in display order.",
      "collectionGroup": "catalogPlans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "reviews",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Rating aggregates for a technician.",
      "collectionGroup": "reviews",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "technicianId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "supportTickets",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "lastMessageAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "supportTickets",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "lastMessageAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Catalog listings: active rows in display order.",
      "collectionGroup": "catalogAppliances",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "catalogServices",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "applianceId", "order": "ASCENDING" },
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "catalogIssues",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "applianceId", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "catalogBrands",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "banners",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "popularServices",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Diagnosis lookup for the issues a customer selected.",
      "collectionGroup": "diagnosisRules",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "applianceId", "order": "ASCENDING" },
        { "fieldPath": "issueId", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Technician options: who is active and covers the booking's pincode.",
      "collectionGroup": "technicians",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "pincodes", "arrayConfig": "CONTAINS" }
      ]
    }
  ],
  "fieldOverrides": []
}
