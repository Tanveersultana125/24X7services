# dependencies
node_modules/

# build output
.next/
out/
packages/*/dist/
# The functions bundle, and only that. A bare `lib/` matches every directory
# called lib at any depth, which quietly kept frontend/lib — firebase.ts,
# format.ts, the whole data layer — out of the repository.
backend/functions/lib/
*.tsbuildinfo
next-env.d.ts

# The root .gitignore ignores .env* unanchored, which would swallow these too.
# They carry no secrets and the README points new contributors straight at them.
!**/.env.example

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
database-debug.log

# emulator state, written by --export-on-exit
.emulator-data/

# capacitor / android
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/google-services.json

# testing
coverage/

# Frames make_service_clips.py slices on its way to an mp4.
frontend/.clip-frames/
