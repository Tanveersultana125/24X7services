# Copy to .env.local. Nothing here is secret: every NEXT_PUBLIC_ value is
# compiled into the bundle and readable by anyone who installs the app.
# Secrets — the Razorpay key secret, WhatsApp/SMS credentials, any AI key —
# live only in Cloud Functions secrets and never in this file.

# --- Firebase (web app config, from the Firebase console) --------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-customerapp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Push notifications ------------------------------------------------------
# The Web Push certificate key pair, from the Firebase console under Project
# settings, Cloud Messaging, Web configuration. Leave it empty and the switch
# under Profile, Settings stays off and says so — nothing else breaks.
# Push needs HTTPS (or localhost) and does not work inside the emulator suite:
# Cloud Messaging has no emulator, so a device registered against a demo
# project gets a token nothing can send to.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Local development -------------------------------------------------------
# true points Auth, Firestore, Storage and Functions at the emulator suite.
NEXT_PUBLIC_USE_EMULATORS=true
# true builds a demo with no backend at all: the catalog is read from
# public/demo-data.bundle (regenerate it with `npm run demo:bundle`) and sign-in,
# booking and payments are switched off. Set this on a hosted preview such as
# Vercel when there is no Firebase project behind it.
NEXT_PUBLIC_DEMO_MODE=false
# 127.0.0.1 for a browser on this machine. An Android emulator reaches the host
# at 10.0.2.2; a physical device needs this machine's LAN address.
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# --- Google Maps -------------------------------------------------------------
# Restrict the key by HTTP referrer for the web build and by Android package
# name plus SHA-1 for the app build, or it can be lifted straight out of the
# bundle and billed to you.
NEXT_PUBLIC_MAPS_KEY=

# --- Razorpay ----------------------------------------------------------------
# Public key id only. The key secret belongs in a Cloud Functions secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Push notifications ------------------------------------------------------
# The Web Push certificate key pair from the Firebase console. Without it the
# notifications toggle in Settings stays off and says so. Receiving a message
# while the app is closed also needs public/firebase-messaging-sw.js (Phase 6).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- App Check ---------------------------------------------------------------
# The reCAPTCHA Enterprise site key. App Check stays off until this is set, so
# the four callables that take no sign-in are open until then. Setting it here
# is only half the job: APP_CHECK_ENFORCED on the functions is what makes the
# backend refuse an unattested call.
NEXT_PUBLIC_APPCHECK_SITE_KEY=
# Debug token for local development, registered against this browser in the
# Firebase console. Production uses Play Integrity on Android and reCAPTCHA
# Enterprise on the web.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
